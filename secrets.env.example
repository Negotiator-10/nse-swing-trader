# nse_paper_v1 -- Kite Connect credentials TEMPLATE.
#
# Copy this file to `secrets.env`, fill in your real values, and NEVER commit it
# (secrets.env is gitignored). Load it into your shell before running any live/data
# script, e.g. in PowerShell:
#     Get-Content secrets.env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }
# or in Git Bash:
#     set -a; source secrets.env; set +a
#
# Do NOT paste these values into chat. The PAPER stage needs the paid Kite Connect
# plan ONLY for market data (websocket + historical); it places NO real orders.

KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
# Access token is generated daily by the Kite login flow (Phase 4); leave blank until then.
KITE_ACCESS_TOKEN=
